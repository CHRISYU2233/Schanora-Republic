+++ b/internal/application/service/schanora_accounts.go
@@ -0,0 +1,86 @@
+package service
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"net/mail"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// SchanoraAccounts is enabled by the Schanora release's link flags.
+var SchanoraAccounts = "off"
+
+var errCompanyEmail = errors.New("Schanora requires a Schaeffler or Vitesco work email")
+var errCompanyTicket = errors.New("Schanora registration ticket is missing, invalid or expired")
+
+func companyEmail(email string) (name, normalized string, ok bool) {
+	normalized = strings.ToLower(strings.TrimSpace(email))
+	address, err := mail.ParseAddress(normalized)
+	if err != nil || address.Address != normalized || strings.Count(normalized, "@") != 1 {
+		return "", "", false
+	}
+	name, domain, _ := strings.Cut(normalized, "@")
+	switch domain {
+	case "schaeffler.com", "mail.schaeffler.com", "vitesco.com":
+		return name, normalized, true
+	default:
+		return "", "", false
+	}
+}
+
+func validCompanyTicket(keyHex, email, ticket string, now time.Time) bool {
+	if len(ticket) > 100 {
+		return false
+	}
+	expiry, signature, _ := strings.Cut(strings.TrimSpace(ticket), ".")
+	seconds, err := strconv.ParseInt(expiry, 10, 64)
+	if err != nil || seconds <= now.Unix() || seconds > now.Add(24*time.Hour).Unix() {
+		return false
+	}
+	proof, err := base64.RawURLEncoding.DecodeString(signature)
+	if err != nil {
+		return false
+	}
+	key, err := hex.DecodeString(keyHex)
+	if err != nil || len(key) != 32 {
+		return false
+	}
+	mac := hmac.New(sha256.New, key)
+	mac.Write([]byte(email + "\n" + expiry))
+	return hmac.Equal(proof, mac.Sum(nil))
+}
+
+func checkSchanoraRegistration(req *types.RegisterRequest) error {
+	if SchanoraAccounts != "on" {
+		return nil
+	}
+	name, email, ok := companyEmail(req.Email)
+	if !ok {
+		return errCompanyEmail
+	}
+	if !req.SchanoraAdminApproved && !validCompanyTicket(os.Getenv("SCHANORA_REGISTRATION_KEY"), email, req.SchanoraTicket, time.Now()) {
+		return errCompanyTicket
+	}
+	req.Email = email
+	req.Username = name
+	return nil
+}
+
+func schanoraAccountAllowed(user *types.User) bool {
+	if user == nil {
+		return false
+	}
+	if SchanoraAccounts != "on" {
+		return true
+	}
+	_, _, workEmail := companyEmail(user.Email)
+	return workEmail || (user.ID != "" && user.ID == os.Getenv("SCHANORA_LEGACY_ACCOUNT_ID"))
+}
